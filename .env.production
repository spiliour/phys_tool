# Paste your ngrok URL here before building (no trailing slash)
# Example: VITE_SERVER=https://abc123.ngrok-free.app
VITE_SERVER=https://YOUR-NGROK-URL-HERE

# ── Study data collection (Supabase) ──────────────────────────────────────────
# Fill these in before building for the study. See STUDY_SETUP.md for the 3-step
# setup. The anon key is safe to ship in the client (the table is insert-only via
# row-level security). If left as placeholders, "Submit my work" downloads a JSON
# file instead of uploading.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Optional — table name (default: study_sessions)
# VITE_STUDY_TABLE=study_sessions
